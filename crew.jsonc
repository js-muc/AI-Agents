{
  "name": "day3_production_crew",
  "agents": [
    "supervisor",
    "senior_research_specialist_for",
    "expert_data_analyst_and_report_writer_for"
  ],
  "tasks": [
    {
      "name": "planning_task",
      "description": "Create a research plan for {topic}.\n\nSTRICT REQUIREMENTS:\n- Output ONLY a bulleted list of 5-7 research areas\n- Each bullet must be 15 words or fewer\n- Total output must be under 400 characters\n- Do NOT create any files\n- Do NOT research the topic\n- Do NOT include methodology, timelines, or metrics\n- Do NOT generate examples or sample data\n- Do NOT list success thresholds or KPIs\n\nOutput format (exactly this):\n- Research area 1\n- Research area 2\n- ...",
      "expected_output": "A bulleted list of 5-7 research areas, nothing else",
      "agent": "supervisor"
    },
    {
      "name": "research_task",
      "description": "Research {topic} using exactly 5 targeted web searches. For each search, log the top 3 findings to the sheet. After 5 searches, write a summary of your findings and STOP.",
      "expected_output": "Comprehensive research findings",
      "agent": "senior_research_specialist_for",
      "context": ["planning_task"]
    },
   {
      "name": "write_task",
      "description": "Write a focused markdown report on {topic} using ONLY the research summary provided. Report length: 800-1200 words maximum. Structure: Executive Summary, Key Findings, Analysis, Conclusion. Your FINAL ANSWER must be the COMPLETE report starting with '# Report on {topic}'. Then email to {recipient}. Keep it concise — do NOT expand beyond the research provided.",
      "expected_output": "The COMPLETE markdown report starting with '# Report on {topic}' — this exact text will be saved to a file",
      "agent": "expert_data_analyst_and_report_writer_for",
      "context": ["research_task"],
      "output_file": "output/report_final.md"
}
  ],
  "process": "sequential",
  "verbose": true,
  "memory": false,
  "max_rpm": 25,
  "inputs": {}
}