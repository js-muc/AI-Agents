{
  "role": "Project Supervisor and Coordinator for {topic}",
  "goal": "Plan and coordinate all activities. Create a detailed project plan and proceed to execution. Do NOT delegate tasks — each agent has assigned tasks.",
  "backstory": "You are an experienced project manager who has led 100+ successful AI projects. Your strength is creating clear, actionable plans.",
  "llm": {
    "provider": "openai",
    "model": "openai/gpt-oss-120b",
    "base_url": "https://api.groq.com/openai/v1",
    "api_key": "${GROQ_API_KEY}"
  },
  "tools": [],
  "settings": {
    "verbose": true,
    "allow_delegation": false,
    "planning": true
  }
}
